{
  "id": "pty-diff-large-restoration",
  "workspace": {
    "kind": "plain",
    "files": {
      "large.txt": {
        "repeat": "x",
        "count": 1048576
      }
    }
  },
  "model": {
    "steps": [
      {
        "tools": [
          {
            "id": "change",
            "name": "bash",
            "arguments": {
              "command": "python3 -c \"from pathlib import Path; f=Path('large.txt').open('r+b'); f.seek(1); f.write(b'y' * 1048574); f.close(); Path('small.txt').write_text('SMALL_DIFF_E2E\\n')\""
            }
          }
        ]
      },
      {
        "text": [
          "LARGE_CHANGE_DONE"
        ]
      },
      {
        "tools": [
          {
            "id": "restore",
            "name": "bash",
            "arguments": {
              "command": "python3 -c \"from pathlib import Path; f=Path('large.txt').open('r+b'); f.seek(1); f.write(b'x' * 1048574); f.close()\""
            }
          }
        ]
      },
      {
        "text": [
          "LARGE_RESTORE_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "change files"
        },
        {
          "when": {
            "contains": [
              "LARGE_CHANGE_DONE",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "small.txt (added)",
              "+SMALL_DIFF_E2E"
            ]
          },
          "prompt": "restore large file"
        },
        {
          "when": {
            "contains": [
              "small.txt (added)",
              "+SMALL_DIFF_E2E",
              "LARGE_RESTORE_DONE",
              "○"
            ],
            "absent": [
              "large.txt (modified)"
            ]
          },
          "send": "\u0004"
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "small.txt (added)",
              "+SMALL_DIFF_E2E"
            ],
            "absent": [
              "large.txt (modified)"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "files": {
      "small.txt": "SMALL_DIFF_E2E\n"
    }
  }
}
