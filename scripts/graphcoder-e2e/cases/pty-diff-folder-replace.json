{
  "id": "pty-diff-folder-replace",
  "workspace": {
    "kind": "plain",
    "files": {
      "folder/a.txt": "FOLDER_BASE_E2E\n"
    }
  },
  "model": {
    "steps": [
      {
        "tools": [
          {
            "id": "edit",
            "name": "write",
            "arguments": {
              "path": "folder/a.txt",
              "text": "FOLDER_EDIT_E2E\n",
              "media_type": "text/plain",
              "display_name": "a.txt"
            }
          }
        ]
      },
      {
        "text": [
          "FOLDER_EDIT_READY"
        ]
      },
      {
        "when": {
          "user": "replace folder"
        },
        "tools": [
          {
            "id": "replace",
            "name": "bash",
            "arguments": {
              "command": "python3 -c \"from pathlib import Path; Path('folder/a.txt').unlink(); Path('folder').rmdir(); Path('folder').write_text('REPLACED_E2E\\n')\""
            }
          }
        ]
      },
      {
        "text": [
          "FOLDER_CHANGE_READY"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit folder content"
        },
        {
          "when": {
            "contains": [
              "FOLDER_EDIT_READY",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "folder/a.txt (modified)",
              "+FOLDER_EDIT_E2E"
            ]
          },
          "prompt": "replace folder"
        },
        {
          "when": {
            "contains": [
              "folder (added)",
              "+REPLACED_E2E",
              "folder/a.txt (removed)",
              "-FOLDER_BASE_E2E",
              "FOLDER_CHANGE_READY",
              "○"
            ]
          },
          "send": "\u0004"
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "folder (added)",
              "+REPLACED_E2E",
              "folder/a.txt (removed)",
              "-FOLDER_BASE_E2E"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "files": {
      "folder": "REPLACED_E2E\n"
    },
    "absent_files": [
      "folder/a.txt"
    ]
  }
}
