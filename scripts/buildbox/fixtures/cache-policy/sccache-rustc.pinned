#!/bin/bash
# Compiler clients and lazy server restarts must use the persistent cache even
# when callers inherited an obsolete SCCACHE_DIR or supplied a Cargo [env].
export SCCACHE_DIR=/mnt/bb/sccache SCCACHE_CACHE_SIZE=400G
if [ -n "${SCCACHE_SERVER_UDS:-}" ]; then
  # A private server is retired by its job owner, including lazy restarts.
  export SCCACHE_IDLE_TIMEOUT=0
else
  export SCCACHE_IDLE_TIMEOUT=120
fi
unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR CARGO_INCREMENTAL
for a in "$@"; do case $a in incremental=*|-Cincremental=*) exec "$@";; esac; done
exec /home/var/.cargo/bin/sccache "$@"
